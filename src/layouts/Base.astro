---
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource-variable/plus-jakarta-sans';
import frLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import frExt from '@fontsource-variable/fraunces/files/fraunces-latin-ext-wght-normal.woff2?url';
import frItLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-italic.woff2?url';
import frItExt from '@fontsource-variable/fraunces/files/fraunces-latin-ext-wght-italic.woff2?url';
import pjLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import pjExt from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-ext-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, institution, services } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Arama sonuçlarından hariç tut (404 vb.) */
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedTime?: string;
  /** Sayfaya özel ek JSON-LD düğümleri (örn. BlogPosting) */
  jsonLd?: Record<string, unknown>[];
}

const { title, description = site.description, noindex = false, type = 'website', publishedTime, jsonLd = [] } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.tagline}`;
// Sondaki eğik çizgisiz tek biçim (astro.config: trailingSlash 'never')
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path, site.url).href;
const ogImage = new URL(site.ogImage, site.url).href;

const crumbNames: Record<string, string> = {
  hakkimda: 'Hakkımda', hizmetler: 'Hizmetler', atolyeler: 'Atölyeler', blog: 'Blog',
  iletisim: 'İletişim', randevu: 'Randevu', kvkk: 'KVKK Aydınlatma Metni', 'kitap-onerileri': 'Kitap Önerileri',
};
const segments = path.split('/').filter(Boolean);
const breadcrumb = segments.length
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: new URL('/', site.url).href },
        ...segments.map((seg, i) => ({
          '@type': 'ListItem',
          position: i + 2,
          name: i === segments.length - 1 && title ? title : crumbNames[seg] ?? seg,
          item: new URL('/' + segments.slice(0, i + 1).join('/'), site.url).href,
        })),
      ],
    }
  : null;

const id = (hash: string) => `${site.url}/#${hash}`;
const sameAs = site.contact.instagram ? [site.contact.instagram] : undefined;
const { hoursSpec, city, region } = site.contact;

// schema.org'da "Psychologist" tipi yok; yerel işletme için ProfessionalService kullanılır.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': id('website'), url: site.url, name: site.name, inLanguage: 'tr-TR', publisher: { '@id': id('business') } },
    {
      '@type': 'Person',
      '@id': id('person'),
      name: site.shortName,
      jobTitle: site.professionalTitle,
      url: site.url,
      image: ogImage,
      worksFor: { '@type': 'Organization', name: institution.name, ...(institution.url && { url: institution.url }) },
      knowsAbout: services.map((s) => s.title),
      ...(sameAs && { sameAs }),
    },
    {
      '@type': ['ProfessionalService', 'LocalBusiness'],
      '@id': id('business'),
      name: site.name,
      description: site.description,
      url: site.url,
      image: ogImage,
      telephone: site.contact.phone,
      email: site.contact.email,
      founder: { '@id': id('person') },
      address: { '@type': 'PostalAddress', streetAddress: site.contact.streetAddress, postalCode: site.contact.postalCode, addressLocality: city, addressRegion: region, addressCountry: 'TR' },
      areaServed: [
        { '@type': 'City', name: city },
        { '@type': 'AdministrativeArea', name: region },
      ],
      openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: hoursSpec.days, opens: hoursSpec.opens, closes: hoursSpec.closes },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Danışmanlık hizmetleri',
        itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.title, description: s.summary } })),
      },
      ...(sameAs && { sameAs }),
    },
    ...(breadcrumb ? [breadcrumb] : []),
    ...jsonLd,
  ],
};
---
<!doctype html>
<html lang="tr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    {[frLatin, frExt, frItLatin, frItExt, pjLatin, pjExt].map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/favicon-v2.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-v2.png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="theme-color" content="#fff8f1" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={type} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip" href="#main">İçeriğe geç</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      const els = document.querySelectorAll('.reveal');
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        }),
        { rootMargin: '0px 0px -8% 0px' },
      );
      els.forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--s-4);
    top: -3rem;
    z-index: 100;
    padding: var(--s-2) var(--s-4);
    border-radius: var(--r-sm);
    background: var(--c-ink);
    color: var(--c-bg);
  }
  .skip:focus { top: var(--s-4); }
</style>
