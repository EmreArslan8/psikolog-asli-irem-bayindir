---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { workshops, workshopCollective, site } from '../data/site';

const icons = ['leaf', 'heart', 'leaf', 'users', 'heart'] as const;
const mailUrl = `mailto:${site.contact.email}?subject=${encodeURIComponent('Kurumsal atölye talebi')}`;
---
<Base title="Atölyeler" description="Mind Society Collective ile Sakarya ve Kocaeli’de kurumsal seramik, yoga, tuval, konuşma ve kintsugi atölyeleri.">
  <PageHero eyebrow="Atölyeler">
    <Fragment slot="title">Birlikte üretmek, <em class="accent">birlikte güçlenmek</em></Fragment>
    Kurumlar ve ekipler için yaratıcılığa, farkındalığa ve paylaşıma alan açan atölyeler.
  </PageHero>

  <section class="section collective">
    <div class="container brand">
      <a class="poster reveal" href={workshopCollective.poster} target="_blank" rel="noopener" aria-label="Mind Society Collective kurumsal atölye afişini büyüt">
        <img src={workshopCollective.poster} alt="Mind Society Collective logosu ve seramik, yoga, tuval, konuşma, kintsugi kurumsal atölye afişi" width="1170" height="1531" loading="lazy" />
      </a>
      <div class="intro reveal">
        <p class="eyebrow">{workshopCollective.region}</p>
        <h2>{workshopCollective.name}</h2>
        <p class="lead">{workshopCollective.intro}</p>
        <p class="text">Seramikten yogaya, tuvalden konuşma ve kintsugiye uzanan atölyelerle ekiplerin birlikte üretebileceği ve paylaşabileceği buluşmalar planlıyoruz.</p>
        <ul class="benefits">
          <li><Icon name="check" />Ekip bağlarını güçlendirme</li>
          <li><Icon name="check" />Motivasyon ve iyi oluşu destekleme</li>
          <li><Icon name="check" />Yaratıcılık ve üretkenliğe alan açma</li>
        </ul>
        <a class="instagram" href={workshopCollective.instagram} target="_blank" rel="noopener noreferrer"><Icon name="instagram" />{workshopCollective.handle}<Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section types">
    <div class="container">
      <div class="head reveal">
        <p class="eyebrow">Atölye deneyimleri</p>
        <h2>Ekibinizle <em class="accent">yeni bir deneyim</em></h2>
      </div>
      <div class="cards glass-group">
        {workshops.map((w, i) => (
          <article class="card glass-card reveal">
            <span class="symbol"><Icon name={icons[i % icons.length]} /></span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section contact">
    <div class="container contact-box reveal">
      <div>
        <p class="eyebrow">Birlikte güzel işler yapalım</p>
        <h2>Ekibiniz için bir atölye planlayalım.</h2>
        <p>Atölye içeriği, tarih ve katılım detayları için e-posta ya da Instagram üzerinden bize ulaşabilirsiniz.</p>
      </div>
      <div class="actions">
        <a class="btn btn-primary" href={mailUrl}><Icon name="mail" />E-posta gönder</a>
        <a class="btn btn-ghost" href={workshopCollective.instagram} target="_blank" rel="noopener noreferrer"><Icon name="instagram" />Instagram’dan yazın</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .collective { padding-top: var(--s-8); }
  .brand { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: var(--s-8); align-items: center; }
  .poster { display: block; max-width: 27rem; border-radius: var(--r-card); overflow: hidden; box-shadow: var(--shadow-md); border: 1px solid var(--c-line); }
  .poster img { display: block; width: 100%; height: auto; }
  h2 { font-size: var(--t-h2); line-height: var(--lh-snug); }
  .intro h2 { margin-block: var(--s-3) var(--s-5); }
  .lead { font-family: var(--f-display); font-size: var(--t-h3); line-height: 1.5; }
  .text { margin-top: var(--s-4); color: var(--c-ink-soft); }
  .benefits { list-style: none; padding: 0; display: grid; gap: var(--s-3); margin-block: var(--s-5); color: var(--c-ink-soft); }
  .benefits li { display: flex; gap: var(--s-3); align-items: center; }
  .benefits :global(svg) { width: 1.1rem; height: 1.1rem; flex: none; color: var(--c-accent); }
  .instagram { display: inline-flex; flex-wrap: wrap; gap: var(--s-3); align-items: center; border-bottom: 1px solid var(--c-accent); padding-bottom: var(--s-2); font-size: var(--t-small); }
  .instagram :global(svg) { width: 1.1rem; height: 1.1rem; }
  .types { padding-top: 0; }
  .head { margin-bottom: var(--s-6); }
  .head h2 { margin-top: var(--s-3); }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-5); }
  .card { padding: var(--s-6); border-radius: var(--r-card); }
  .symbol { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; background: var(--c-cream); color: var(--c-accent); margin-bottom: var(--s-5); }
  .symbol :global(svg) { width: 1.5rem; height: 1.5rem; }
  h3 { font-size: var(--t-h3); margin-bottom: var(--s-3); }
  .card p { color: var(--c-ink-soft); font-size: var(--t-small); }
  .contact { padding-top: 0; }
  .contact-box { display: grid; grid-template-columns: 1fr auto; gap: var(--s-7); align-items: center; padding-block: var(--s-7); border-block: 1px solid var(--c-line); }
  .contact-box h2 { margin-block: var(--s-3) var(--s-4); max-width: 27rem; }
  .contact-box p:last-child { color: var(--c-ink-soft); max-width: 36rem; }
  .actions { display: grid; gap: var(--s-3); }
  .actions .btn { justify-content: center; }
  @media (max-width: 900px) {
    .brand { grid-template-columns: 1fr; gap: var(--s-7); }
    .poster { max-width: 24rem; margin-inline: auto; }
    .cards { grid-template-columns: repeat(2, 1fr); }
    .contact-box { grid-template-columns: 1fr; }
    .actions { justify-self: start; }
  }
  @media (max-width: 600px) { .cards { grid-template-columns: 1fr; } }
</style>
