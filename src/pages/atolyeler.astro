---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { workshops, payment, whatsappUrl } from '../data/site';

const tl = new Intl.NumberFormat('tr-TR');
---
<Base title="Atölyeler" description="Çocuklar, gençler ve ebeveynler için küçük gruplarla düzenlenen uygulamalı atölyeler. Tarih, ücret ve kayıt bilgileri.">
  <PageHero eyebrow="Atölyeler">
    <Fragment slot="title">Birlikte öğrenmek, <em class="accent">birlikte büyümek</em></Fragment>
    Küçük gruplarla, uygulamalı atölyeler. Kayıt için WhatsApp'tan yazmanız yeterli.
  </PageHero>

  <section class="section list">
    <div class="container">
      {workshops.map((w, i) => (
        <article class="card reveal">
          <div class:list={['poster', `t${i % 3}`]}>
            {w.image ? (
              <img src={w.image} alt={`${w.title} afişi`} width="400" height="500" loading="lazy" />
            ) : (
              <div class="auto">
                <Icon name={i % 3 === 0 ? 'heart' : i % 3 === 1 ? 'users' : 'leaf'} />
                <span class="aud-tag">{w.audience.split(' · ')[0]}</span>
                <strong>{w.title}</strong>
                {w.price && <span class="pill">{tl.format(w.price)}₺</span>}
              </div>
            )}
          </div>

          <div class="info">
            <h2>{w.title}</h2>
            <p class="aud">{w.audience}</p>
            <p class="text">{w.text}</p>
          </div>

          <div class="buy">
            <ul class="meta">
              <li><Icon name="clock" /><span>{w.date ?? 'Tarih yakında'}{w.time && <><br />Saat {w.time}</>}</span></li>
              {w.format && <li><Icon name={w.format === 'Online' ? 'video' : 'pin'} />{w.format}</li>}
            </ul>
            <p class="price">{w.price ? `${tl.format(w.price)}₺` : 'Bilgi için yazın'}</p>
            <a class="btn btn-primary" href={whatsappUrl(`Merhaba, "${w.title}" atölyesine kayıt olmak istiyorum.`)} target="_blank" rel="noopener">
              Kayıt Ol <Icon name="arrow" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  {payment.iban && (
    <section class="section pay">
      <div class="container box reveal">
        <div>
          <p class="eyebrow">Ödeme</p>
          <h2>Kayıt ve ödeme nasıl yapılır?</h2>
          <ol>
            <li>WhatsApp'tan katılmak istediğiniz atölyeyi yazın.</li>
            <li>Ücreti aşağıdaki hesaba havale/EFT ile gönderin.</li>
            <li>Dekontu WhatsApp'tan iletin; kaydınız onaylansın.</li>
          </ol>
        </div>
        <div class="bank">
          <p class="k">Hesap sahibi</p>
          <p class="v">{payment.holder}</p>
          <p class="k">Banka</p>
          <p class="v">{payment.bank}</p>
          <p class="k">IBAN</p>
          <p class="iban" data-iban>{payment.iban}</p>
          <button class="btn btn-ghost copy" type="button" data-copy>IBAN'ı kopyala</button>
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const iban = document.querySelector<HTMLElement>('[data-iban]');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(iban!.textContent!.replace(/\s/g, ''));
      btn.textContent = 'Kopyalandı ✓';
    } catch {
      btn.textContent = 'Kopyalanamadı, elle seçin';
    }
    setTimeout(() => (btn.textContent = "IBAN'ı kopyala"), 2500);
  });
</script>

<style>
  .list { padding-top: var(--s-8); }
  .list .container { display: grid; gap: var(--s-4); }
  .card {
    display: grid;
    grid-template-columns: 15rem 1fr 15rem;
    gap: var(--s-7);
    align-items: center;
    padding: var(--s-5);
    border-radius: var(--r-card);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    box-shadow: var(--shadow-sm);
  }
  .poster {
    aspect-ratio: 4 / 5;
    border-radius: calc(var(--r-card) - 0.25rem);
    overflow: hidden;
    transition: transform 0.5s var(--ease);
  }
  .card:hover .poster { transform: translateY(-4px) rotate(-1deg); }
  .poster img { width: 100%; height: 100%; object-fit: cover; }
  .auto {
    height: 100%;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--s-3);
    padding: var(--s-5);
    color: var(--c-ink);
  }
  .t0 { background: linear-gradient(160deg, #fde1d6, #f9b8a4); }
  .t1 { background: linear-gradient(160deg, #fbe9dc, #f5cdb8); }
  .t2 { background: linear-gradient(160deg, #ffe6d9, #f59a82); }
  .auto :global(svg) { width: 2.5rem; height: 2.5rem; color: var(--c-accent); }
  .aud-tag { font-size: var(--t-eyebrow); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; }
  .auto strong { font-family: var(--f-display); font-weight: 500; font-size: var(--t-h3); line-height: 1.2; }
  .pill { padding: 0.35rem 0.9rem; border-radius: var(--r-pill); background: #fff; font-weight: 600; font-size: var(--t-small); }
  h2 { font-size: var(--t-h2); line-height: var(--lh-snug); }
  .aud { margin-top: var(--s-2); font-size: var(--t-eyebrow); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--c-muted); }
  .text { margin-top: var(--s-4); color: var(--c-ink-soft); max-width: 36rem; }
  .buy { display: grid; gap: var(--s-4); }
  .meta { list-style: none; padding: 0; display: grid; gap: var(--s-3); }
  .meta li { display: flex; align-items: flex-start; gap: var(--s-3); line-height: 1.4; }
  .meta :global(svg) { width: 1.4rem; height: 1.4rem; flex: none; color: var(--c-accent); margin-top: 0.1rem; }
  .price { font-family: var(--f-display); font-size: var(--t-h2); line-height: 1; }
  .buy .btn { justify-content: center; }

  .pay { padding-top: 0; }
  .box {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--s-7);
    align-items: start;
    padding-block: var(--s-7);
    border-block: 1px solid var(--c-line);
  }
  .box h2 { font-size: var(--t-h2); margin-block: var(--s-3) var(--s-5); }
  ol { padding-left: 1.2rem; display: grid; gap: var(--s-3); color: var(--c-ink-soft); }
  .bank { padding: var(--s-5); border-radius: var(--r-card); background: var(--c-surface); border: 1px solid var(--c-line); box-shadow: var(--shadow-sm); }
  .k { font-size: var(--t-eyebrow); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--c-muted); margin-top: var(--s-3); }
  .k:first-child { margin-top: 0; }
  .v { font-weight: 500; }
  .iban { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 1.05rem; letter-spacing: 0.04em; word-break: break-all; }
  .copy { margin-top: var(--s-4); }
  @media (max-width: 800px) {
    .card { grid-template-columns: 1fr; gap: var(--s-5); }
    .poster { max-width: 18rem; }
    .box { grid-template-columns: 1fr; gap: var(--s-5); }
  }
  @media (max-width: 1000px) and (min-width: 801px) { .card { grid-template-columns: 12rem 1fr; } .buy { grid-column: 2; grid-template-columns: 1fr 1fr; align-items: center; } }
  @media (prefers-reduced-motion: reduce) { .poster { transition: none; } }
</style>
