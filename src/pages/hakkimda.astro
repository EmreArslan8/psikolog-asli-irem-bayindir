---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Portrait from '../components/Portrait.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import Institution from '../components/Institution.astro';
import { about, principles } from '../data/site';
---
<Base title="Hakkımda" description="Psikolog, aile danışmanı ve çocuk gelişimi uzmanı Aslı İrem Bayındır’ın eğitimi, mesleki deneyimi ve çalışma yaklaşımı.">
  <PageHero eyebrow="Hakkımda">
    <Fragment slot="title">Merhaba, ben <em class="accent">Aslı İrem</em>.</Fragment>
  </PageHero>

  <section class="section intro">
    <div class="container grid">
      <div class="reveal"><Portrait /></div>
      <div class="copy reveal">
        <p class="big">{about.intro}</p>
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section cv">
    <div class="container cols">
      <div class="block reveal">
        <h2>Eğitim</h2>
        <ul class="timeline">
          {about.education.map((e) => (
            <li><strong>{e.title}</strong><span>{e.place}</span></li>
          ))}
        </ul>
      </div>
      <div class="block reveal">
        <h2>Aldığım eğitimler</h2>
        <ul class="checks">
          {about.trainings.map((t) => (
            <li><Icon name="check" />{t.startsWith('MOXO')
              ? <a href="https://moxoturkiye.com/" target="_blank" rel="noopener noreferrer">{t}</a>
              : t}</li>
          ))}
        </ul>
      </div>
      <div class="block reveal">
        <h2>Çalışma ilkelerim</h2>
        <ul class="checks">
          {principles.map((p) => <li><Icon name="check" /><span><strong>{p.title}:</strong> {p.text}</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section experience">
    <div class="container">
      <p class="eyebrow">Mesleki yolculuğum</p>
      <h2 class="history-title">Deneyim ve stajlar</h2>
      <div class="cols history">
        <div class="block reveal">
          <h3>İş deneyimi</h3>
          <ul class="timeline">
            {about.experience.map((e) => (
              <li><strong>{e.name}</strong><span>{e.period}</span></li>
            ))}
          </ul>
        </div>
        <div class="block reveal">
          <h3>Mesleki stajlar</h3>
          <ul class="timeline">
            {about.internships.map((e) => (
              <li><strong>{e.name}</strong><span>{e.detail} · {e.period}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Institution />

  <CtaBand />
</Base>

<style>
  .intro { padding-top: var(--s-8); }
  .grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: var(--s-8); align-items: center; }
  .copy { display: grid; gap: var(--s-4); color: var(--c-ink-soft); font-size: var(--t-lead); }
  .big {
    font-family: var(--f-display);
    font-size: var(--t-h3);
    line-height: 1.45;
    letter-spacing: -0.02em;
    color: var(--c-ink);
  }
  .cv { padding-top: 0; }
  .experience { padding-top: 0; padding-bottom: 0; }
  .history-title { font-size: var(--t-h2); margin-top: var(--s-3); }
  h3 { font-size: var(--t-h3); margin-bottom: var(--s-5); }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-5);
    position: relative;
    isolation: isolate;
  }
  .history { grid-template-columns: 1fr 1fr; }
  .cols::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--s-6));
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 12% 28%, rgb(249 184 164 / 0.26), transparent 48%),
      radial-gradient(ellipse at 85% 78%, rgb(251 233 220 / 0.8), transparent 52%);
  }
  .block {
    padding: var(--s-6);
    border-radius: var(--r-lg);
    background: linear-gradient(135deg, rgb(255 255 255 / 0.7), rgb(255 251 246 / 0.42));
    border: 1px solid rgb(255 255 255 / 0.86);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.92),
      0 2px 6px rgb(73 55 49 / 0.025),
      0 20px 48px -24px rgb(73 55 49 / 0.16);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
  }
  h2 { font-size: var(--t-h3); margin-bottom: var(--s-5); }
  ul { list-style: none; padding: 0; display: grid; gap: var(--s-4); }
  .timeline li { display: grid; gap: var(--s-1); padding-left: var(--s-4); border-left: 2px solid rgb(242 118 102 / 0.55); }
  .timeline span { font-size: var(--t-small); color: var(--c-muted); }
  .checks li { display: flex; gap: var(--s-3); color: var(--c-ink-soft); font-size: var(--t-small); }
  .checks :global(svg) { width: 1.1rem; height: 1.1rem; flex: none; color: var(--c-accent); margin-top: 0.15rem; }
  .checks strong { color: var(--c-ink); }
  .checks a { color: var(--c-primary); text-decoration: underline; text-underline-offset: 0.2em; }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; gap: var(--s-7); }
    .grid > :first-child { max-width: 22rem; margin-inline: auto; width: 100%; }
    .cols { grid-template-columns: 1fr; }
  }
</style>
