---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactInfo from '../components/ContactInfo.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';

const mapSrc = site.contact.mapsQuery
  ? `https://www.google.com/maps?q=${encodeURIComponent(site.contact.mapsQuery)}&hl=tr&z=16&output=embed`
  : null;
---
<Base title="İletişim" description="Psikolog Aslı İrem Bayındır iletişim bilgileri: telefon, WhatsApp, e-posta ve çalışma saatleri.">
  <PageHero eyebrow="İletişim">
    <Fragment slot="title">Bana <em class="accent">ulaşın</em></Fragment>
    Sorularınız ya da randevu talebiniz için dilediğiniz kanaldan yazabilirsiniz.
  </PageHero>

  <section class="section wrap">
    <div class="container grid">
      <div class="reveal">
        <ContactInfo />
        {mapSrc && (
          <iframe class="map" src={mapSrc} title="Konum haritası" loading="lazy" referrerpolicy="no-referrer-when-downgrade" />
        )}
      </div>
      <div class="reveal"><ContactForm /></div>
    </div>
  </section>
</Base>

<style>
  .wrap { padding-top: var(--s-8); }
  .grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: var(--s-7); align-items: start; }
  .map { width: 100%; height: 18rem; border: 0; border-radius: var(--r-lg); margin-top: var(--s-5); }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
</style>
