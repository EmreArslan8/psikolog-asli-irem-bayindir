---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Fees from '../components/Fees.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/site';
---
<Base title="Hizmetler" description="Çocuk danışmanlığı (3–12 yaş), ergen danışmanlığı (13–18 yaş) ve ebeveyn danışmanlığı. Yüz yüze ve online görüşme seçenekleri.">
  <PageHero eyebrow="Hizmetler">
    <Fragment slot="title">Çocuk, ergen ve <em class="accent">ebeveyn</em> danışmanlığı</Fragment>
    Her gelişim dönemine uygun yöntemlerle, ailenin tamamını gözeten bir destek.
  </PageHero>

  <div class="page">
    <span class="orb o1" aria-hidden="true"></span>
    <span class="orb o2" aria-hidden="true"></span>

    <section class="section list">
      <div class="container">
        {services.map((s, i) => (
          <article id={s.slug} class:list={['svc', 'glass', 'reveal', { flip: i % 2 === 1 }]}>
            <div class="art">
              <div class="disc"><img src={s.image} alt="" width="320" height="240" loading="lazy" /></div>
              <span class="age">{s.age}</span>
            </div>
            <div class="main">
              <h2>{s.title}</h2>
              <ul class="chips">{s.chips.map((c) => <li>{c}</li>)}</ul>
              <p class="lead">{s.summary}</p>
              <p class="body">{s.body}</p>
              <h3>Sık çalışılan konular</h3>
              <ul class="topics">{s.topics.map((t) => <li><Icon name="check" />{t}</li>)}</ul>
              <a class="btn btn-primary" href={`/randevu?hizmet=${s.slug}`}>Randevu Al <Icon name="arrow" /></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section fees-wrap">
      <div class="container"><div class="glass fees-box reveal"><Fees flat row /></div></div>
    </section>
  </div>

  <CtaBand />
</Base>

<style>
  .page { position: relative; overflow: hidden; isolation: isolate; }
  .orb { position: absolute; z-index: -1; border-radius: 50%; filter: blur(80px); pointer-events: none; }
  .o1 { width: 28rem; height: 28rem; left: -8rem; top: 8%; background: rgb(242 118 102 / 0.3); }
  .o2 { width: 32rem; height: 32rem; right: -10rem; top: 48%; background: rgb(255 190 160 / 0.55); }

  .list { padding-top: var(--s-8); }
  .list .container { display: grid; gap: var(--s-6); }
  .glass {
    border-radius: var(--r-card);
    background: linear-gradient(135deg, rgb(255 255 255 / 0.7), rgb(255 255 255 / 0.4));
    border: 1px solid var(--c-line);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.9) inset, 0 30px 60px -30px rgb(90 50 40 / 0.3);
    -webkit-backdrop-filter: blur(24px) saturate(1.5);
    backdrop-filter: blur(24px) saturate(1.5);
  }
  .svc {
    display: grid;
    grid-template-columns: 17rem 1fr;
    gap: var(--s-7);
    align-items: center;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    scroll-margin-top: 6rem;
  }
  .svc.flip { grid-template-columns: 1fr 17rem; }
  .svc.flip .art { order: 2; }

  .art { display: grid; justify-items: center; gap: var(--s-4); }
  .disc {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 255 255 / 0.9), rgb(242 118 102 / 0.16));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.9);
  }
  .disc img { width: 78%; height: auto; transition: transform 0.6s var(--ease); }
  .svc:hover .disc img { transform: scale(1.05) rotate(-1.5deg); }
  .age { padding: 0.3rem 0.9rem; border-radius: 999px; background: rgb(242 118 102 / 0.14); font-size: var(--t-eyebrow); font-weight: 600; }

  .main { display: grid; gap: var(--s-4); justify-items: start; }
  h2 { font-size: var(--t-h1); line-height: var(--lh-tight); letter-spacing: var(--ls-heading); }
  .chips, .topics { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .chips li { padding: 0.3rem 0.85rem; border-radius: 999px; background: rgb(242 118 102 / 0.14); font-size: var(--t-small); font-weight: 500; }
  .lead { font-size: var(--t-lead); line-height: var(--lh-body); color: var(--c-ink); max-width: 44rem; }
  .body { color: var(--c-ink-soft); max-width: 44rem; }
  h3 { margin-top: var(--s-2); font-size: var(--t-eyebrow); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--c-muted); font-family: var(--f-body); font-weight: 600; }
  .topics li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0.4rem 0.9rem 0.4rem 0.7rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.65);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.9);
    font-size: var(--t-small);
  }
  .topics :global(svg) { width: 1rem; height: 1rem; color: var(--c-accent); flex: none; }
  .main .btn { margin-top: var(--s-2); }

  .fees-wrap { padding-top: 0; }
  .fees-box { padding: var(--s-6) clamp(1.5rem, 1rem + 2.5vw, 3rem); }

  @media (max-width: 860px) {
    .svc, .svc.flip { grid-template-columns: 1fr; gap: var(--s-5); }
    .svc.flip .art { order: 0; }
    .art { grid-template-columns: 8rem auto; justify-content: start; align-items: center; justify-items: start; gap: var(--s-4); }
    .disc { width: 8rem; }
  }
  @media (prefers-reduced-motion: reduce) { .disc img { transition: none; } }
</style>
