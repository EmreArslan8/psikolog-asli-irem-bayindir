---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/site';
---
<Base title="Hizmetler" description="Çocuk danışmanlığı (3–12 yaş), ergen danışmanlığı (13–18 yaş) ve ebeveyn danışmanlığı. Yüz yüze ve online görüşme seçenekleri.">
  <PageHero eyebrow="Hizmetler">
    <Fragment slot="title">Çocuk, ergen ve <em class="accent">ebeveyn</em> danışmanlığı</Fragment>
    Her gelişim dönemine uygun yöntemlerle, ailenin tamamını gözeten bir destek.
  </PageHero>

  <section class="section list">
    <div class="container">
      {services.map((s, i) => (
        <article id={s.slug} class:list={['svc', 'reveal', s.tone]}>
          <div class="side">
            <img src={s.image} alt="" width="240" height="180" loading="lazy" />
            <span class="num">0{i + 1}</span>
            <span class="age">{s.age}</span>
          </div>
          <div class="main">
            <h2>{s.title}</h2>
            <ul class="chips">{s.chips.map((c) => <li>{c}</li>)}</ul>
            <p class="lead">{s.summary}</p>
            <p>{s.body}</p>
            <a class="btn btn-primary" href={`/randevu?hizmet=${s.slug}`}>
              Randevu Al <Icon name="arrow" />
            </a>
          </div>
          <div class="topics">
            <h3>Sık çalışılan konular</h3>
            <ul>{s.topics.map((t) => <li><Icon name="check" />{t}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .list { padding-top: var(--s-8); }
  .list .container { display: grid; gap: var(--s-5); }
  .svc {
    display: grid;
    grid-template-columns: 14rem 1.4fr 1fr;
    gap: var(--s-7);
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    border-radius: var(--r-lg);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    scroll-margin-top: 6rem;
  }
  .peach { --tone: var(--c-peach); --tone-ink: var(--c-accent); }
  .sage { --tone: var(--c-sage); --tone-ink: var(--c-accent); }
  .lilac { --tone: var(--c-lilac); --tone-ink: var(--c-accent); }
  .side { display: flex; flex-direction: column; gap: var(--s-3); align-items: flex-start; }
  .side img { width: 100%; aspect-ratio: 4 / 3; object-fit: contain; padding: var(--s-4); border-radius: var(--r-md); background: var(--c-cream); margin-bottom: var(--s-2); }
  .num { font-family: var(--f-display); font-style: italic; font-size: var(--t-h1); line-height: 1; color: var(--c-accent); }
  .age { padding: var(--s-1) var(--s-3); border-radius: var(--r-sm); background: var(--c-surface); font-size: var(--t-eyebrow); font-weight: 600; white-space: nowrap; }
  .main { display: grid; gap: var(--s-4); align-content: start; justify-items: start; }
  h2 { font-size: var(--t-h2); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--s-2); list-style: none; padding: 0; }
  .chips li { display: block; padding: 0.35rem 0.85rem; border-radius: var(--r-pill); background: var(--c-accent-soft); font-size: var(--t-small); font-weight: 500; }
  .main > p:not(.lead) { color: var(--c-ink-soft); }
  .topics { padding: var(--s-5); border-radius: var(--r-md); background: var(--c-bg); align-self: start; }
  h3 { font-family: var(--f-body); font-size: var(--t-eyebrow); font-weight: 700; letter-spacing: var(--ls-eyebrow); text-transform: uppercase; margin-bottom: var(--s-4); }
  ul { list-style: none; padding: 0; display: grid; gap: var(--s-3); }
  li { display: flex; gap: var(--s-2); align-items: center; font-size: var(--t-small); }
  li :global(svg) { width: 1rem; height: 1rem; color: var(--tone-ink); flex: none; }
  @media (max-width: 960px) {
    .svc { grid-template-columns: 1fr; gap: var(--s-5); }
    .side { flex-direction: row; flex-wrap: wrap; align-items: center; }
    .side img { max-width: 16rem; flex-basis: 100%; }
  }
</style>
