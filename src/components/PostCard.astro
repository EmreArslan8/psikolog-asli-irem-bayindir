---
import Icon from './Icon.astro';
import type { Post } from '../data/site';

interface Props { post: Post; delay?: number }
const { post, delay = 0 } = Astro.props;

const covers: Record<string, string> = {
  Çocuk: '/illustrations/cocuk.svg',
  Ergen: '/illustrations/ergen.svg',
  Ebeveyn: '/illustrations/ebeveyn.svg',
};
const cover = post.image ?? covers[post.category] ?? '/illustrations/ebeveyn.svg';
const d = new Date(post.date);
const day = d.getUTCDate();
const month = new Intl.DateTimeFormat('tr-TR', { month: 'short', timeZone: 'UTC' }).format(d);
const full = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(d);
---
<a class="post reveal" href={`/blog/${post.slug}`} style={`transition-delay:${delay}ms`}>
  <div class:list={['cover', { auto: !post.image }]}>
    <img src={cover} alt="" width="640" height="400" loading="lazy" />
    <time class="date" datetime={post.date} aria-label={full}><strong>{day}</strong><span>{month}</span></time>
    <span class="cat">{post.category}</span>
  </div>
  <div class="text">
    <h3>{post.title}</h3>
    <p>{post.excerpt}</p>
    <span class="read">Oku <Icon name="arrow" /></span>
  </div>
</a>

<style>
  .post {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--r-card);
    overflow: hidden;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    box-shadow: var(--shadow-sm);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease), opacity 0.8s var(--ease);
  }
  .post:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }
  .cover { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--c-cream); }
  .cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s var(--ease); }
  .cover.auto { background: radial-gradient(circle at 30% 20%, #fff, var(--c-accent-soft) 70%); }
  .cover.auto img { object-fit: contain; padding: var(--s-5) var(--s-7); }
  .post:hover .cover img { transform: scale(1.05); }
  .date {
    position: absolute;
    top: var(--s-4);
    left: var(--s-4);
    display: grid;
    justify-items: center;
    min-width: 3rem;
    padding: 0.4rem 0.6rem;
    border-radius: var(--r-md);
    background: rgb(255 255 255 / 0.85);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: 0 2px 10px -2px rgb(58 41 37 / 0.2);
    line-height: 1.1;
  }
  .date strong { font-family: var(--f-display); font-size: 1.25rem; font-weight: 500; }
  .date span { font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-ink-soft); }
  .cat {
    position: absolute;
    right: var(--s-4);
    bottom: var(--s-4);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--c-dark);
    color: var(--c-primary-ink);
    font-size: var(--t-eyebrow);
    font-weight: 500;
  }
  .text { display: grid; align-content: start; gap: var(--s-3); padding: var(--s-5) var(--s-5) var(--s-6); }
  h3 { font-size: var(--t-h3); line-height: var(--lh-snug); }
  p { color: var(--c-ink-soft); font-size: var(--t-small); line-height: 1.6; }
  .read { display: inline-flex; align-items: center; gap: var(--s-2); margin-top: var(--s-2); font-size: var(--t-small); font-weight: 600; transition: gap 0.3s var(--ease); }
  .read :global(svg) { width: 1rem; height: 1rem; }
  .post:hover .read { gap: var(--s-3); }
  @media (prefers-reduced-motion: reduce) { .post, .cover img { transition: none; } }
</style>
