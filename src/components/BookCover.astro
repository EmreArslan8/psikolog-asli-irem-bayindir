---
interface Props { title: string; author: string; index: number; compactOnMobile?: boolean }
const { title, author, index, compactOnMobile = false } = Astro.props;
const palettes = [
  { color: '#e6ad98', ink: '#493731' },
  { color: '#b8c7b3', ink: '#304334' },
  { color: '#ecd9b8', ink: '#59442c' },
  { color: '#786071', ink: '#fff6eb' },
];
const palette = palettes[index % palettes.length];
---
<div class:list={['book-scene', { compact: compactOnMobile }]} style={`--cover:${palette.color};--cover-ink:${palette.ink}`}>
  <div class="volume">
    <div class="cover">
      <span class="collection">Ebeveyn kitaplığı</span>
      <h3>{title}</h3>
      <p class="author">{author}</p>
    </div>
  </div>
</div>
<style>
  .book-scene { width: 100%; max-width: 15rem; margin-inline: auto; padding: 0.5rem 0.75rem 1rem 0.25rem; perspective: 900px; }
  .volume {
    position: relative;
    aspect-ratio: 3 / 4.25;
    transform: rotateY(-9deg) rotateZ(-2deg);
    transform-style: preserve-3d;
    transition: transform 0.5s var(--ease);
    border-radius: 2px 6px 6px 2px;
    box-shadow: -4px 5px 8px rgb(73 55 49 / 0.1), 12px 20px 22px -14px rgb(73 55 49 / 0.4);
  }
  .volume::before {
    content: '';
    position: absolute;
    inset: 4px -9px 4px auto;
    width: 13px;
    border-radius: 0 4px 4px 0;
    background: repeating-linear-gradient(to bottom, #fff9ed 0 2px, #e7dccb 2px 3px);
    border: 1px solid #d8cbb9;
    transform: translateZ(-2px);
  }
  .cover {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 1.4rem 1.1rem 1.3rem 1.5rem;
    border-radius: inherit;
    color: var(--cover-ink);
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.16), transparent 5%, rgb(255 255 255 / 0.22) 7%, rgb(0 0 0 / 0.07) 9%, transparent 12%),
      linear-gradient(130deg, rgb(255 255 255 / 0.2), transparent 60%), var(--cover);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08), inset 0 1px 0 rgb(255 255 255 / 0.35);
  }
  .collection { font-size: 0.55rem; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.8; padding-bottom: 0.65rem; border-bottom: 1px solid currentColor; }
  h3 { font-family: var(--f-display); font-size: clamp(1.12rem, 1rem + 0.25vw, 1.4rem); font-weight: 500; line-height: 1.15; letter-spacing: -0.025em; margin-top: 1rem; text-wrap: balance; }
  .author { margin-top: auto; font-size: 0.66rem; font-weight: 500; line-height: 1.5; border-top: 1px solid currentColor; padding-top: 0.6rem; }
  :global(a:hover) .volume { transform: rotateY(-3deg) rotateZ(0) translateY(-4px); }
  @media (prefers-reduced-motion: reduce) { .volume { transition: none; } }
  @media (max-width: 600px) {
    .compact { padding: 0.2rem 0.5rem 0.3rem 0; }
    .compact .cover { padding: 0.6rem 0.45rem 0.55rem 0.65rem; }
    .compact .collection { font-size: 0.25rem; padding-bottom: 0.3rem; letter-spacing: 0.1em; }
    .compact h3 { font-size: 0.58rem; margin-top: 0.45rem; }
    .compact .author { font-size: 0.32rem; padding-top: 0.25rem; }
    .compact .volume::before { width: 8px; right: -5px; }
  }
</style>
