---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { nav, whatsappUrl } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="header" data-header>
  <div class="container bar">
    <Logo />
    <nav class="nav" id="site-nav" aria-label="Ana menü">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <a class="btn btn-primary nav-cta" href="/randevu">Randevu Al</a>
      <a class="btn btn-whatsapp nav-wa" href={whatsappUrl()} target="_blank" rel="noopener">
        <Icon name="whatsapp" /> WhatsApp'tan yazın
      </a>
    </nav>
    <a class="btn btn-primary cta" href="/randevu">Randevu Al</a>
    <button class="toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menüyü aç" data-toggle>
      <Icon name="menu" class="i-open" />
      <Icon name="close" class="i-close" />
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-toggle]')!;
  toggle.addEventListener('click', () => {
    const open = header.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Menüyü kapat' : 'Menüyü aç');
  });
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background-color 0.3s, box-shadow 0.3s;
  }
  .header.is-scrolled {
    background: rgb(255 248 241 / 0.9);
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--c-line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    min-height: 5.25rem;
  }
  .nav { display: flex; align-items: center; margin-inline: auto; }
  .nav ul { display: flex; gap: var(--s-2); list-style: none; padding: 0; }
  .nav ul a {
    position: relative;
    display: block;
    padding: var(--s-2) var(--s-4);
    font-size: var(--t-body);
    color: var(--c-ink-soft);
    transition: color 0.2s;
  }
  .nav ul a::after {
    content: '';
    position: absolute;
    left: var(--s-4);
    right: var(--s-4);
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--c-accent);
    transform: scaleX(0);
    transition: transform 0.35s var(--ease);
  }
  .nav ul a:hover, .nav ul a[aria-current='page'] { color: var(--c-ink); }
  .nav ul a:hover::after, .nav ul a[aria-current='page']::after { transform: scaleX(1); }
  .cta { flex: none; padding: 0.8rem 1.6rem; }
  .nav-wa, .nav-cta { display: none; }

  .toggle {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--c-line);
    border-radius: var(--r-btn);
    background: var(--c-surface);
    cursor: pointer;
  }
  .toggle :global(svg) { width: 1.25rem; height: 1.25rem; }
  .toggle :global(.i-close) { display: none; }

  @media (max-width: 860px) {
    .cta { display: none; }
    .toggle { display: grid; position: relative; z-index: 2; }
    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin: 0;
      flex-direction: column;
      align-items: stretch;
      gap: var(--s-3);
      padding: var(--s-2) var(--gutter) var(--s-5);
      border-radius: 0 0 1.5rem 1.5rem;
      background: rgb(255 251 246 / 0.98);
      backdrop-filter: blur(14px);
      border-top: 1px solid var(--c-line);
      box-shadow: 0 24px 40px -20px rgb(58 41 37 / 0.25);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transform-origin: top;
      transition: opacity 0.25s var(--ease), transform 0.35s var(--ease), visibility 0.25s;
    }
    .nav ul { flex-direction: column; gap: 0; }
    .nav ul li + li { border-top: 1px solid var(--c-line); }
    .nav ul a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: var(--s-4) 0;
      font-size: 1.0625rem;
      color: var(--c-ink);
    }
    .nav ul a::after {
      position: static;
      width: 0.45rem;
      height: 0.45rem;
      border-radius: 50%;
      transform: scale(0);
    }
    .nav ul a:hover::after, .nav ul a[aria-current='page']::after { transform: scale(1); }
    .nav-cta, .nav-wa { display: inline-flex; justify-content: center; padding: 0.85rem 1.25rem; font-size: var(--t-small); }
    .is-open .nav { opacity: 1; visibility: visible; transform: none; }
    .is-open .toggle :global(.i-open) { display: none; }
    .is-open .toggle :global(.i-close) { display: block; }
  }
  @media (prefers-reduced-motion: reduce) { .nav { transition: none; } }
</style>
