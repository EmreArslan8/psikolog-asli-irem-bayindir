---
import { site } from '../data/site';
---
<a class="logo" href="/" aria-label={`${site.name} — Ana sayfa`}>
  <span class="mark">
    <img src="/logo-mark.png" alt="" width="48" height="48" />
  </span>
  <span class="text">
    <span class="role">{site.title}</span>
    <span class="name">{site.shortName}</span>
  </span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: var(--s-3); position: relative; z-index: 2; }
  .mark {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    flex: none;
    border-radius: 50%;
    transition: transform 0.5s var(--ease);
  }
  .mark img { width: 100%; height: 100%; object-fit: contain; }
  .logo:hover .mark { transform: scale(1.05); }
  .text { display: flex; flex-direction: column; line-height: 1.15; }
  .role {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-accent);
  }
  .name {
    font-family: var(--f-display);
    font-size: var(--t-h3);
    font-weight: 400;
    letter-spacing: -0.02em;
  }
</style>
