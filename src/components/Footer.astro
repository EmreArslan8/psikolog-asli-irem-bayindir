---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Ribbon from './Ribbon.astro';
import { site, nav, services, institution } from '../data/site';

const { contact } = site;
const year = new Date().getFullYear();
---
<footer class="footer has-ribbon">
  <Ribbon variant="wave" style="right:-8%;bottom:10%;width:40rem;opacity:.35" />
  <div class="container grid">
    <div class="brand">
      <Logo />
      <p>{site.tagline}. Yüz yüze ve online görüşmeler.</p>
      <p class="inst">
        {institution.role} · {institution.url ? <a href={institution.url} target="_blank" rel="noopener">{institution.name}</a> : institution.name}
      </p>
    </div>

    <div>
      <h2 class="title">Sayfalar</h2>
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/hizmetler">Çalışma Alanlarım</a></li>
        <li><a href="/kitap-onerileri">Ebeveynler İçin Kitap Önerileri</a></li>
      </ul>
    </div>

    <div>
      <h2 class="title">Hizmetler</h2>
      <ul>
        {services.map((s) => <li><a href={`/hizmetler#${s.slug}`}>{s.title}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="title">İletişim</h2>
      <ul class="contact">
        <li><Icon name="phone" /><a href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a></li>
        <li><Icon name="mail" /><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        {contact.address && <li><Icon name="pin" /><span>{contact.address}</span></li>}
        <li><Icon name="clock" /><span>{contact.hours}</span></li>
        {contact.instagram && <li><Icon name="instagram" /><a href={contact.instagram} target="_blank" rel="noopener">Instagram</a></li>}
      </ul>
    </div>
  </div>

  <div class="container bottom">
    <p>© {year} {site.name}. Tüm hakları saklıdır.</p>
    <a href="/kvkk">KVKK Aydınlatma Metni</a>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-cream);
    color: var(--c-ink-soft);
    padding-block: var(--s-8) var(--s-6);
    font-size: var(--t-small);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr 1.5fr;
    gap: var(--s-7);
  }
  .brand p { margin-top: var(--s-4); max-width: 18rem; }
  .brand .inst { color: var(--c-accent); }
  .title {
    font-family: var(--f-body);
    font-size: var(--t-eyebrow);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--c-accent);
    margin-bottom: var(--s-4);
  }
  ul { list-style: none; padding: 0; display: grid; gap: var(--s-3); }
  a { transition: color 0.2s; }
  a:hover { color: var(--c-accent); }
  .contact li { display: flex; gap: var(--s-3); align-items: flex-start; }
  .contact :global(svg) { width: 1.1rem; height: 1.1rem; flex: none; margin-top: 0.15rem; color: var(--c-accent); }
  .contact a { word-break: break-all; }
  .bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px solid var(--c-line);
    color: var(--c-muted);
  }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .grid { grid-template-columns: 1fr; gap: var(--s-6); } }
</style>
