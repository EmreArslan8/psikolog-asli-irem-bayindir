---
import Icon from '../Icon.astro';
import Fees from '../Fees.astro';
import { services } from '../../data/site';

const tabIcons = { cocuk: 'heart', ergen: 'leaf', ebeveyn: 'users' } as const;
---
<section class="section has-ribbon" id="hizmetler">
  <span class="orb o1" aria-hidden="true"></span>
  <span class="orb o2" aria-hidden="true"></span>
  <div class="container">
    <div class="head reveal">
      <p class="eyebrow">Hizmetler</p>
      <h2>Her yaşın kendi dili, <em class="accent">her ailenin</em> kendi hikâyesi var.</h2>
    </div>

    <div class="glass reveal">
    <div class="tabs" role="tablist" aria-label="Hizmetler" data-tabs>
      <span class="thumb" aria-hidden="true"></span>
      {services.map((s, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${s.slug}`}
          aria-controls={`panel-${s.slug}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          <Icon name={tabIcons[s.slug as keyof typeof tabIcons] ?? 'heart'} />
          <span>{s.title.replace(' Danışmanlığı', '')}</span>
        </button>
      ))}
    </div>

    <div class="stage">
      <div class="panels">
        {services.map((s, i) => (
          <article
            class="panel"
            role="tabpanel"
            id={`panel-${s.slug}`}
            aria-labelledby={`tab-${s.slug}`}
            hidden={i !== 0}
          >
            <div class="top">
              <div>
                <span class="age">{s.age}</span>
                <h3>{s.title}</h3>
              </div>
              <img src={s.image} alt="" width="320" height="240" loading="lazy" />
            </div>
            <p class="lead">{s.summary}</p>
            <ul class="topics">
              {s.topics.map((t) => <li><Icon name="check" />{t}</li>)}
            </ul>
            <div class="foot">
              <a class="more" href={`/hizmetler#${s.slug}`}>Ayrıntılı bilgi <Icon name="arrow" /></a>
            </div>
          </article>
        ))}
      </div>
      <div class="side"><Fees flat /></div>
    </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((list) => {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const thumb = list.querySelector<HTMLElement>('.thumb')!;

    const moveThumb = (tab: HTMLElement) => {
      thumb.style.width = `${tab.offsetWidth}px`;
      thumb.style.transform = `translateX(${tab.offsetLeft}px)`;
    };
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      });
      moveThumb(tab);
      if (focus) tab.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (dir) { e.preventDefault(); select(tabs[(i + dir + tabs.length) % tabs.length], true); }
      });
    });

    const current = () => tabs.find((t) => t.getAttribute('aria-selected') === 'true')!;
    moveThumb(current());
    list.classList.add('ready');
    window.addEventListener('resize', () => moveThumb(current()), { passive: true });
    document.fonts?.ready.then(() => moveThumb(current()));
  });
</script>

<style>
  .head { max-width: 40rem; margin-inline: auto; text-align: center; margin-bottom: var(--s-6); }
  .head .eyebrow { justify-content: center; }
  h2 { font-size: var(--t-h2); margin-block: var(--s-4); }
  .head .lead { color: var(--c-ink-soft); }

  #hizmetler { position: relative; overflow: hidden; isolation: isolate; }
  .orb { position: absolute; z-index: -1; border-radius: 50%; filter: blur(70px); pointer-events: none; }
  .o1 { width: 26rem; height: 26rem; left: -6rem; top: 18%; background: rgb(242 118 102 / 0.38); }
  .o2 { width: 30rem; height: 30rem; right: -8rem; bottom: 4%; background: rgb(255 190 160 / 0.6); }

  .glass {
    padding: clamp(1rem, 0.5rem + 2vw, 2rem);
    border-radius: var(--r-card);
    background: linear-gradient(135deg, rgb(255 255 255 / 0.7), rgb(255 255 255 / 0.4));
    border: 1px solid var(--c-line);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.9) inset, 0 30px 60px -30px rgb(90 50 40 / 0.35);
    -webkit-backdrop-filter: blur(24px) saturate(1.5);
    backdrop-filter: blur(24px) saturate(1.5);
  }

  .tabs {
    position: relative;
    display: flex;
    width: fit-content;
    max-width: 100%;
    margin-bottom: var(--s-6);
    padding: 0.3rem;
    gap: 0.2rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.45);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.7);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar { display: none; }
  .thumb {
    position: absolute;
    top: 0.3rem;
    bottom: 0.3rem;
    left: 0;
    width: 0;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 2px 10px -2px rgb(90 50 40 / 0.25);
    opacity: 0;
  }
  .tabs.ready .thumb { opacity: 1; transition: transform 0.45s var(--ease), width 0.45s var(--ease); }
  button {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0.6rem 1.25rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font: inherit;
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--c-ink-soft);
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.3s;
  }
  button :global(svg) { width: 1.05rem; height: 1.05rem; transition: color 0.3s, transform 0.4s var(--ease); }
  button:hover { color: var(--c-ink); }
  button[aria-selected='true'] { color: var(--c-ink); }
  button[aria-selected='true'] :global(svg) { color: var(--c-accent); transform: scale(1.1); }
  .tabs:not(.ready) button[aria-selected='true'] { background: #fff; }

  .stage { display: grid; grid-template-columns: 1.7fr 1fr; gap: var(--s-7); align-items: stretch; }
  .panels { display: grid; }
  .panel { display: grid; align-content: start; gap: var(--s-5); animation: in 0.5s var(--ease); }
  .panel[hidden] { display: none; }
  @keyframes in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .top { display: flex; justify-content: space-between; align-items: center; gap: var(--s-5); }
  .top img { width: 9rem; height: auto; flex: none; }
  .age {
    display: inline-block;
    margin-bottom: var(--s-3);
    padding: 0.25rem 0.8rem;
    border-radius: 999px;
    background: rgb(242 118 102 / 0.14);
    font-size: var(--t-eyebrow);
    font-weight: 600;
  }
  h3 { font-size: var(--t-h1); line-height: var(--lh-tight); letter-spacing: var(--ls-heading); }
  .panel .lead { color: var(--c-ink-soft); font-size: var(--t-lead); line-height: var(--lh-body); max-width: 40rem; }
  .topics { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .topics li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0.4rem 0.9rem 0.4rem 0.7rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.6);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.9);
    font-size: var(--t-small);
    color: var(--c-ink);
  }
  .topics :global(svg) { width: 1rem; height: 1rem; color: var(--c-accent); flex: none; }
  .foot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-5); margin-top: var(--s-2); }
  .more { display: inline-flex; align-items: center; gap: var(--s-2); font-weight: 500; border-bottom: 1px solid rgb(73 55 49 / 0.2); transition: gap 0.3s var(--ease), border-color 0.3s; }
  .more:hover { gap: var(--s-3); border-color: var(--c-accent); }
  .more :global(svg) { width: 1rem; height: 1rem; }
  .side { display: grid; padding-left: var(--s-7); border-left: 1px solid rgb(73 55 49 / 0.1); }

  /* JS yokken tüm paneller alt alta görünür */
  :global(.no-js) .panel[hidden] { display: grid; }
  :global(.no-js) .panels { gap: var(--s-4); }
  :global(.no-js) .tabs { display: none; }

  @media (max-width: 960px) {
    .stage { grid-template-columns: 1fr; gap: var(--s-6); }
    .side { padding: var(--s-6) 0 0; border-left: 0; border-top: 1px solid rgb(73 55 49 / 0.1); }
  }
  @media (max-width: 560px) {
    .tabs { width: 100%; }
    button { flex: 1; justify-content: center; padding: 0.65rem 0.5rem; }
    button :global(svg) { display: none; }
    .top img { width: 6rem; }
    .foot .btn { flex: 1 1 100%; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) { .panel { animation: none; } .tabs.ready .thumb { transition: none; } }
</style>
