---
/** İlk video büyük gösterilir; tıklayınca sayfada oynar (youtube-nocookie). Diğerleri YouTube'da açılır. */
import Icon from '../Icon.astro';
import { videos, youtubeChannel } from '../../data/site';

const [main, ...rest] = videos;
const thumb = (id: string, q = 'maxresdefault') => `https://i.ytimg.com/vi/${id}/${q}.jpg`;
---
{main && (
  <section class="section videos">
    <span class="orb" aria-hidden="true"></span>
    <div class="container">
      <div class="head reveal">
        <p class="eyebrow">Videolar</p>
        <h2>Ebeveynler için <em class="accent">kısa rehberler</em></h2>
      </div>

      <div class="stage reveal">
        <div class="player" data-player data-id={main.id}>
          <img src={thumb(main.id)} alt="" width="1280" height="720" loading="lazy" onerror={`this.onerror=null;this.src='${thumb(main.id, 'hqdefault')}'`} />
          <button type="button" class="play" aria-label={`Videoyu oynat: ${main.title}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
          </button>
        </div>
      </div>

      {(
        <>
        <div class="more reveal">
          {rest.map((v) => (
            <a class="item" href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener">
              <span class="th">
                <img src={thumb(v.id, 'mqdefault')} alt="" width="320" height="180" loading="lazy" />
                <span class="mini" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
              </span>
              <span class="t">{v.title}</span>
            </a>
          ))}
          <a class="item channel" href={youtubeChannel ?? 'https://www.youtube.com/'} target="_blank" rel="noopener">
            <span class="th logo" aria-hidden="true">
              <svg class="yt" viewBox="0 0 68 48"><rect width="68" height="48" rx="12" fill="var(--c-dark)" /><path d="M27 14v20l18-10z" fill="#fff" /></svg>
            </span>
            <span class="t">YouTube kanalıma katılın <Icon name="arrow" /></span>
          </a>
        </div>
        </>
      )}
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((box) => {
    box.querySelector('.play')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.id}?autoplay=1&rel=0`;
      iframe.title = 'YouTube videosu';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
    });
  });
</script>

<style>
  .videos { position: relative; overflow: hidden; isolation: isolate; background: var(--c-surface); border-block: 1px solid var(--c-line); color: var(--c-ink); padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem); }
  .orb { position: absolute; z-index: -1; right: -8rem; top: -6rem; width: 28rem; height: 28rem; border-radius: 50%; background: rgb(242 118 102 / 0.22); filter: blur(90px); pointer-events: none; }
  .head { text-align: center; margin-bottom: var(--s-6); }
  .head .eyebrow { justify-content: center; }
  h2 { font-size: var(--t-h2); margin-top: var(--s-4); }
  .stage { max-width: 917px; margin-inline: auto; text-align: center; }
  .player {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--r-card);
    overflow: hidden;
    background: #000;
    border: 1px solid var(--c-line);
    box-shadow: var(--shadow-md);
  }
  .player img, .player :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; object-fit: cover; }
  .player img { transition: transform 0.8s var(--ease); }
  .player:hover img { transform: scale(1.03); }
  .play {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.6);
    background: rgb(255 255 255 / 0.18);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: #fff;
    cursor: pointer;
    transition: transform 0.4s var(--ease), background 0.3s;
  }
  .play:hover { transform: scale(1.08); background: var(--c-accent); border-color: var(--c-accent); }
  .play svg { width: 2rem; height: 2rem; margin-left: 0.2rem; }

  .more {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-3);
    max-width: 917px;
    margin: var(--s-5) auto 0;
  }
  .item {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    align-items: center;
    gap: var(--s-3);
    min-height: 5rem;
    padding: var(--s-3);
    border-radius: var(--r-card);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.3s, border-color 0.3s;
  }
  .item:hover { border-color: var(--c-coral-light); box-shadow: var(--shadow-md); }
  .th { position: relative; aspect-ratio: 16 / 9; border-radius: var(--r-md); overflow: hidden; background: #000; }
  .th img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .item:hover .th img { transform: scale(1.06); }
  .mini {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
  }
  .mini svg { width: 0.85rem; height: 0.85rem; margin-left: 0.1rem; }
  .t { font-family: var(--f-display); font-size: var(--t-small); line-height: 1.35; text-wrap: balance; }
  .item:hover .t { color: var(--c-accent); }
  .th.logo { display: grid; place-items: center; background: var(--c-cream); }
  .yt { width: 2.25rem; height: auto; }
  .channel .t { display: inline-flex; align-items: center; gap: var(--s-2); }
  .channel .t :global(svg) { width: 1rem; height: 1rem; flex: none; transition: transform 0.3s var(--ease); }
  .channel:hover .t :global(svg) { transform: translateX(4px); }
  @media (max-width: 800px) { .more { grid-template-columns: 1fr; } .item { grid-template-columns: 7rem 1fr; } }
  @media (max-width: 560px) { .play { width: 4rem; height: 4rem; } }
  @media (prefers-reduced-motion: reduce) { .player img, .th img, .play { transition: none; } }
</style>
