---
import Icon from '../Icon.astro';
import Ribbon from '../Ribbon.astro';
import { workshops } from '../../data/site';
---
{workshops.length > 0 && (
  <section class="section workshops has-ribbon">
    <Ribbon variant="wave" style="left:-10%;bottom:4%;width:48rem;opacity:.4" />
    <div class="container">
      <div class="head reveal">
        <p class="eyebrow">Atölyeler</p>
        <h2>Birlikte öğrenmek, <em class="accent">birlikte büyümek</em></h2>
      </div>
      <ul class="list">
        {workshops.map((w, i) => (
          <li class="item reveal" style={`transition-delay:${i * 100}ms`}>
            <span class="n">0{i + 1}</span>
            <div>
              <p class="aud">{w.audience}</p>
              <h3>{w.title}</h3>
              <p class="text">{w.text}</p>
            </div>
          </li>
        ))}
      </ul>
      <a class="btn btn-primary cta reveal" href="/atolyeler">
        Tüm atölyeler ve kayıt <Icon name="arrow" />
      </a>
    </div>
  </section>
)}

<style>
  .workshops { position: relative; padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem); }
  .head {
    max-width: 40rem;
    margin: 0 auto var(--s-6);
    text-align: center;
  }
  .head .eyebrow { justify-content: center; }
  h2 { font-size: var(--t-h2); margin-top: var(--s-4); }
  .list { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-5); }
  .item {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--s-5);
    padding: var(--s-6);
    border-radius: var(--r-card);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    box-shadow: var(--shadow-sm);
  }
  .n { font-family: var(--f-display); font-size: var(--t-h2); color: var(--c-accent); line-height: 1; }
  .aud {
    font-size: var(--t-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--c-muted);
  }
  h3 { font-size: var(--t-h3); margin-block: var(--s-2) var(--s-3); }
  .text { font-size: var(--t-small); color: var(--c-ink-soft); }
  .cta { margin: var(--s-6) auto 0; display: flex; width: fit-content; }
  @media (max-width: 960px) {
    .list { grid-template-columns: 1fr; }
  }
</style>
