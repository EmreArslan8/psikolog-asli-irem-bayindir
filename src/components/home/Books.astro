---
import Icon from '../Icon.astro';
import BookCover from '../BookCover.astro';
import { books } from '../../data/books';
---
<section class="section books" data-books-carousel>
  <div class="container">
    <div class="head reveal">
      <p class="eyebrow">Ebeveynler için kitap önerileri</p>
      <h2>Birlikte büyürken <em class="accent">bir sayfa açın</em></h2>
    </div>
    <div class="book-controls">
      <button type="button" data-book-prev aria-label="Önceki kitap önerileri" aria-controls="book-track" disabled><Icon name="arrow" /></button>
      <button type="button" data-book-next aria-label="Sonraki kitap önerileri" aria-controls="book-track"><Icon name="arrow" /></button>
    </div>
    <div class="cards glass-group" id="book-track" tabindex="0" role="region" aria-label="Kaydırılabilir kitap önerileri">
      {books.map((b, i) => (
        <a class="card glass-card" href={`/kitap-onerileri#${b.id}`}>
          <BookCover title={b.title} author={b.author} index={i} />
          <span class="discover">Kitabı incele <Icon name="arrow" /></span>
        </a>
      ))}
    </div>
    <a class="btn btn-primary cta reveal" href="/kitap-onerileri">Yaşa ve ihtiyaca göre kitap seçin <Icon name="arrow" /></a>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-books-carousel]').forEach((section) => {
    const track = section.querySelector<HTMLElement>('.cards');
    const previous = section.querySelector<HTMLButtonElement>('[data-book-prev]');
    const next = section.querySelector<HTMLButtonElement>('[data-book-next]');
    if (!track || !previous || !next) return;
    const update = () => {
      previous.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
    };
    const move = (direction: number) => {
      const card = track.querySelector<HTMLElement>('.card');
      if (!card) return;
      const step = card.getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap);
      track.scrollBy({ left: direction * step, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    };
    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    track.addEventListener('scroll', update, { passive: true });
    track.addEventListener('keydown', (event) => {
      if (event.target !== track) return;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        move(event.key === 'ArrowRight' ? 1 : -1);
      }
    });
    new ResizeObserver(update).observe(track);
    update();
  });
</script>
<style>
  .books { padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem); }
  .head { max-width: 40rem; margin: 0 auto var(--s-6); text-align: center; }
  .head .eyebrow { justify-content: center; }
  h2 { font-size: var(--t-h2); margin-top: var(--s-4); }
  .book-controls { display: flex; justify-content: flex-end; gap: .5rem; margin-bottom: 1rem; }
  .book-controls button { display: grid; place-items: center; width: 3rem; height: 3rem; padding: 0; border: 1px solid var(--c-line); border-radius: 50%; background: var(--c-surface); color: var(--c-ink); cursor: pointer; }
  .book-controls button:hover:not(:disabled) { background: var(--c-accent-soft); }
  .book-controls button:disabled { opacity: .35; cursor: default; }
  .book-controls :global(svg) { width: 1.25rem; height: 1.25rem; }
  [data-book-prev] :global(svg) { transform: rotate(180deg); }
  .cards { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 2 * var(--s-5)) / 3); gap: var(--s-5); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 1rem; scrollbar-width: thin; scrollbar-color: var(--c-accent) var(--c-line); }
  .card { min-width: 0; scroll-snap-align: start; }
  .cards { overflow-y: hidden; }
  .cards .card :global(.volume) { transform: rotateY(-9deg) rotateZ(-2deg); transition: none; }
  .book-controls button:focus-visible, .cards:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 4px; }
  .card { display: flex; flex-direction: column; align-items: flex-start; padding: var(--s-6); border-radius: var(--r-card); }
  .discover { display: inline-flex; align-items: center; gap: var(--s-3); font-size: var(--t-small); margin-top: var(--s-4); align-self: center; }
  .discover :global(svg) { width: 1rem; height: 1rem; color: var(--c-accent); }
  .cta { display: flex; width: fit-content; margin: var(--s-6) auto 0; }
  @media (max-width: 1000px) { .cards { grid-auto-columns: calc((100% - var(--s-5)) / 2); } }
  @media (max-width: 540px) { .cards { grid-auto-columns: 88%; } }
</style>
