---
/** Çerçeveli portre. Fotoğraf yoksa baş harfli sade bir alan gösterir. */
import { site, about } from '../data/site';

interface Props { class?: string; contained?: boolean }
const { class: className, contained = false } = Astro.props;
const initials = site.shortName.split(' ').map((w) => w[0]).slice(0, 2).join('');
---
<div class:list={['portrait', className, { contained }]}>
  <div class="frame">
    {about.photo ? (
      <img src={about.photo} alt={site.name} width="560" height="700" loading="eager" />
    ) : (
      <div class="placeholder" role="img" aria-label={`${site.name} fotoğrafı için alan`}>
        <span class="initials">{initials}</span>
        <span class="hint">Fotoğraf</span>
      </div>
    )}
  </div>
</div>

<style>
  .portrait { position: relative; width: 100%; max-width: 28rem; margin-inline: auto; aspect-ratio: 4 / 5; }
  .portrait::before {
    content: '';
    position: absolute;
    inset: var(--s-5) calc(-1 * var(--s-5)) calc(-1 * var(--s-5)) var(--s-5);
    border: 1px solid var(--c-accent);
    border-radius: var(--r-lg);
  }
  .frame {
    position: absolute;
    inset: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--c-primary);
    box-shadow: var(--shadow-md);
  }
  .portrait.contained::before { inset: 0; }
  .portrait.contained .frame { inset: var(--s-2); }
  .frame img { width: 100%; height: 100%; object-fit: cover; }
  .placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--s-2);
    background: linear-gradient(160deg, var(--c-accent), var(--c-primary));
  }
  .initials {
    font-family: var(--f-display);
    font-size: clamp(4.5rem, 3rem + 6vw, 7.5rem);
    letter-spacing: var(--ls-display);
    line-height: 1;
    color: #fff;
  }
  .hint {
    font-size: var(--t-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.7);
  }
</style>
