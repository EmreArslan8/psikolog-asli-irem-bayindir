---
import Icon from './Icon.astro';
import { site, whatsappUrl } from '../data/site';

const { contact } = site;
const items = [
  { icon: 'whatsapp', label: 'WhatsApp', value: 'Hemen yazın', href: whatsappUrl(), external: true },
  { icon: 'phone', label: 'Telefon', value: contact.phoneDisplay, href: `tel:${contact.phone}` },
  { icon: 'mail', label: 'E-posta', value: contact.email, href: `mailto:${contact.email}` },
  contact.address && { icon: 'pin', label: 'Adres', value: contact.address, href: contact.mapsUrl ?? undefined, external: true },
  { icon: 'clock', label: 'Çalışma saatleri', value: contact.hours },
  contact.instagram && { icon: 'instagram', label: 'Instagram', value: 'Takip edin', href: contact.instagram, external: true },
].filter(Boolean) as { icon: any; label: string; value: string; href?: string; external?: boolean }[];
---
<ul class="info">
  {items.map((it) => {
    const Tag = it.href ? 'a' : 'div';
    return (
      <li>
        <Tag class="item" href={it.href} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener' : undefined}>
          <span class="icon"><Icon name={it.icon} /></span>
          <span>
            <small>{it.label}</small>
            <strong>{it.value}</strong>
          </span>
        </Tag>
      </li>
    );
  })}
</ul>

<style>
  .info { list-style: none; padding: 0; display: grid; gap: var(--s-3); }
  .item {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-4);
    border-radius: var(--r-md);
    border: 1px solid var(--c-line);
    background: var(--c-surface);
    transition: border-color 0.2s, transform 0.25s var(--ease);
  }
  a.item:hover { border-color: var(--c-primary); transform: translateX(4px); }
  .icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border-radius: 50%;
    background: var(--c-cream);
    color: var(--c-primary);
  }
  .icon :global(svg) { width: 1.25rem; height: 1.25rem; }
  small { display: block; font-size: var(--t-eyebrow); color: var(--c-muted); }
  strong { font-weight: 600; word-break: break-word; }
</style>
