---
import Icon from './Icon.astro';
import { services } from '../data/site';
---
<form
  class="form"
  action="/api/randevu"
  method="POST"
  data-form
>
  <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />

  <div class="row">
    <label>
      <span>Adınız Soyadınız *</span>
      <input name="ad_soyad" required minlength="2" maxlength="100" autocomplete="name" />
    </label>
    <label>
      <span>Telefon *</span>
      <input name="telefon" type="tel" required maxlength="30" autocomplete="tel" inputmode="tel" placeholder="05xx xxx xx xx" />
    </label>
  </div>

  <div class="row">
    <label>
      <span>E-posta</span>
      <input name="email" type="email" maxlength="254" autocomplete="email" />
    </label>
    <label>
      <span>Hizmet</span>
      <select name="hizmet">
        {services.map((s) => <option value={s.title} data-slug={s.slug}>{s.title}</option>)}
        <option>Henüz emin değilim</option>
      </select>
    </label>
  </div>

  <div class="row">
    <label>
      <span>Görüşme kimin için?</span>
      <select name="danisan">
        <option value="">Seçiniz</option>
        <option>Çocuğum için</option>
        <option>Ergen çocuğum için</option>
        <option>Kendim için</option>
        <option>Aile olarak</option>
      </select>
    </label>
    <label>
      <span>Tercih ettiğiniz gün</span>
      <input name="tarih" type="date" data-date />
    </label>
  </div>

  <fieldset>
    <legend>Görüşme tercihi</legend>
    <label class="pill"><input type="radio" name="gorusme" value="Yüz yüze" checked /> <span>Yüz yüze</span></label>
    <label class="pill"><input type="radio" name="gorusme" value="Online" /> <span>Online</span></label>
  </fieldset>

  <label>
    <span>Kısaca mesajınız</span>
    <textarea name="mesaj" rows="4" maxlength="2000" placeholder="Görüşme talebinizi kısaca yazabilirsiniz. Lütfen hassas sağlık bilgisi paylaşmayın."></textarea>
  </label>

  <label class="consent">
    <input type="checkbox" name="kvkk" required />
    <span><a href="/kvkk" target="_blank">KVKK Aydınlatma Metni</a>'ni okudum; bilgilerimin randevu amacıyla işlenmesini kabul ediyorum. *</span>
  </label>

  <button class="btn btn-primary submit" type="submit">Talebi Gönder <Icon name="arrow" /></button>
  <p class="status" role="status" aria-live="polite" data-status></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-form]').forEach((form) => {
    // /randevu?hizmet=<slug> ile gelindiyse ilgili hizmeti seçili getir
    const slug = new URLSearchParams(location.search).get('hizmet');
    const option = slug && form.querySelector<HTMLOptionElement>(`option[data-slug="${CSS.escape(slug)}"]`);
    if (option) option.selected = true;

    const date = form.querySelector<HTMLInputElement>('[data-date]');
    if (date) date.min = new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 10);

    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (button.disabled) return;
      const data = new URLSearchParams();
      new FormData(form).forEach((value, key) => {
        if (typeof value === 'string') data.append(key, value);
      });

      button.disabled = true;
      status.className = 'status';
      status.textContent = 'Gönderiliyor…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' }, signal: AbortSignal.timeout(20000) });
        const json = await res.json();
        if (!res.ok || !json.success) {
          status.classList.add('err');
          status.textContent = json.message || 'Talebiniz gönderilemedi. Lütfen tekrar deneyin.';
          return;
        }
        form.reset();
        status.classList.add('ok');
        status.textContent = 'Teşekkürler! Talebiniz gönderildi, en kısa sürede size dönüş yapacağım.';
      } catch {
        status.classList.add('err');
        status.textContent = 'Bir sorun oluştu. Lütfen WhatsApp ya da telefonla ulaşın.';
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .form {
    display: grid;
    gap: var(--s-5);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--r-card);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    box-shadow: var(--shadow-sm);
  }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5); }
  label { display: grid; gap: var(--s-2); }
  label > span, legend { font-size: var(--t-small); font-weight: 600; }
  input:not([type='checkbox'], [type='radio']), select, textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid var(--c-line);
    border-radius: var(--r-sm);
    background-color: var(--c-bg);
    transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;
  }
  select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--c-ink-soft) 50%), linear-gradient(135deg, var(--c-ink-soft) 50%, transparent 50%); background-position: calc(100% - 1.15rem) 55%, calc(100% - 0.8rem) 55%; background-size: 0.35rem 0.35rem; background-repeat: no-repeat; padding-right: 2.4rem; }
  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--c-primary);
    background-color: var(--c-surface);
    box-shadow: 0 0 0 4px rgb(242 118 102 / 0.15);
  }
  textarea { resize: vertical; }
  fieldset { border: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  legend { width: 100%; margin-bottom: var(--s-2); }
  .pill { display: inline-flex; cursor: pointer; }
  .pill input { position: absolute; opacity: 0; }
  .pill span {
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--c-line);
    border-radius: var(--r-btn);
    font-size: var(--t-small);
    font-weight: 600;
    transition: all 0.2s;
  }
  .pill input:checked + span { background: var(--c-primary); border-color: var(--c-primary); color: #fff; }
  .pill input:focus-visible + span { outline: 2px solid var(--c-accent); outline-offset: 2px; }
  .consent { grid-template-columns: auto 1fr; align-items: start; font-size: var(--t-small); color: var(--c-ink-soft); }
  .consent input { width: 1.1rem; height: 1.1rem; margin-top: 0.2rem; accent-color: var(--c-primary); }
  .consent span { font-weight: 400; }
  .consent a { text-decoration: underline; color: var(--c-primary); }
  .submit { justify-self: start; }
  .submit:disabled { opacity: 0.6; cursor: wait; }
  .status:empty { display: none; }
  .status { font-size: var(--t-small); padding: var(--s-3) var(--s-4); border-radius: var(--r-sm); background: var(--c-cream); }
  .status.ok { background: var(--c-accent-soft); color: var(--c-ink); }
  .status.err { background: var(--c-accent-soft); color: #8a4b1f; }
  .hp { display: none; }
  @media (max-width: 600px) { .row { grid-template-columns: 1fr; } .submit { justify-self: stretch; } }
</style>
