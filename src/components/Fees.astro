---
import Icon from './Icon.astro';
import { fees, whatsappUrl } from '../data/site';

interface Props { flat?: boolean; row?: boolean; showAppointment?: boolean }
const { flat = false, row = false, showAppointment = true } = Astro.props;
const rows = [
  { label: 'Online', icon: 'video', price: fees.online },
  { label: 'Yüz yüze', icon: 'pin', price: fees.faceToFace },
] as const;
const visible = rows.filter((r) => r.price);
const tl = new Intl.NumberFormat('tr-TR');
---
{visible.length > 0 && (
  <aside class:list={['fees', 'reveal', { flat, row }]}>
    <p class="tag">Görüşme ücretleri</p>
    <ul>
      {visible.map((r) => (
        <li>
          <span class="label"><Icon name={r.icon} />{r.label}</span>
          <span class="price">{tl.format(r.price!)}₺</span>
        </li>
      ))}
    </ul>
    <div class="actions">
      {showAppointment && <a class="btn btn-primary" href="/randevu">Randevu Talebi <Icon name="arrow" /></a>}
      <a class="btn btn-whatsapp" href={whatsappUrl()} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp'tan Yaz</a>
    </div>
  </aside>
)}

<style>
  .fees {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--s-4);
    padding: var(--s-6);
    border-radius: var(--r-card);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    box-shadow: var(--shadow-sm);
  }
  .tag { font-size: var(--t-eyebrow); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--c-muted); }
  ul { list-style: none; padding: 0; display: grid; align-content: center; }
  li { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); padding-block: var(--s-4); }
  li + li { border-top: 1px solid var(--c-line); }
  .label { display: inline-flex; align-items: center; gap: var(--s-3); color: var(--c-ink-soft); }
  .label :global(svg) { width: 1.25rem; height: 1.25rem; color: var(--c-accent); }
  .price { font-family: var(--f-display); font-size: var(--t-h2); line-height: 1; }
  .fees.flat { grid-template-rows: none; align-content: start; gap: var(--s-2); padding: 0; border: 0; background: none; box-shadow: none; border-radius: 0; }
  .fees.row { grid-template-rows: none; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--s-7); }
  .fees.row .tag { font-family: var(--f-display); font-size: var(--t-h3); letter-spacing: 0; text-transform: none; color: var(--c-ink); max-width: 9rem; line-height: 1.2; }
  .fees.row ul { display: flex; justify-content: center; align-content: normal; }
  .fees.row li { flex-direction: column; align-items: flex-start; gap: var(--s-2); padding: 0 var(--s-7); }
  .fees.row li + li { border-top: 0; border-left: 1px solid rgb(73 55 49 / 0.12); }
  .fees.row .actions { margin-top: 0; min-width: 14rem; }
  @media (max-width: 860px) {
    .fees.row { grid-template-columns: 1fr; gap: var(--s-5); }
    .fees.row .tag { max-width: none; }
    .fees.row ul { justify-content: flex-start; }
    .fees.row li { padding: 0 var(--s-5) 0 0; }
    .fees.row li + li { padding-left: var(--s-5); }
  }
  .fees.flat .actions { margin-top: var(--s-5); }
  .actions { display: grid; gap: var(--s-2); margin-top: var(--s-2); }
  .actions .btn { justify-content: center; }
</style>
