---
import { teenFilms } from '../data/films';
interface Props { carousel?: boolean; }
const { carousel = false } = Astro.props;
const animations = new Set(['Inside Out 2', 'Turning Red', 'The Mitchells vs. the Machines', 'Wonder Park']);
---
<section class:list={['section', 'film-library', { 'film-carousel': carousel }]} id="ergen-film-onerileri" aria-labelledby="film-title" data-film-carousel={carousel || undefined}>
  <div class="container">
    <header class="film-intro">
      <p class="eyebrow">Ergenler için</p>
      <h2 id="film-title">Film ve animasyon <em class="accent">önerileri</em></h2>
    </header>
    {carousel && (
      <div class="film-controls">
        <div class="film-buttons">
          <button type="button" data-film-prev aria-label="Önceki film önerileri" aria-controls="film-track" disabled><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m14 6-6 6 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
          <button type="button" data-film-next aria-label="Sonraki film önerileri" aria-controls="film-track"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m10 6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
        </div>
      </div>
    )}
    <div class="film-grid" id={carousel ? 'film-track' : undefined} tabindex={carousel ? 0 : undefined} role={carousel ? 'region' : undefined} aria-label={carousel ? 'Kaydırılabilir film önerileri' : undefined}>
      {teenFilms.map((film) => (
        <article class:list={['film-card', animations.has(film.title) ? 'is-animation' : 'is-film']}>
          <div class="film-strip" aria-hidden="true"></div>
          <div class="film-content">
            <div class="film-heading">
              <span class="film-type"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.4" /><path d="M8 4V20M16 4V20M4 9H8M4 15H8M16 9H20M16 15H20" stroke="currentColor" stroke-width="1.4" /></svg>{animations.has(film.title) ? 'Animasyon' : 'Film'}</span>
              <h3>{film.title}</h3>
              <ul class="film-topics" aria-label="Konuşabileceğiniz konular">
                {film.topics.split(', ').map((topic) => <li>{topic}</li>)}
              </ul>
            </div>
            <details class="conversation">
              <summary>Sohbet sorusu <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 4V16M4 10H16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg></summary>
              <blockquote>“{film.question}”</blockquote>
            </details>
          </div>
          <div class="film-strip" aria-hidden="true"></div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-film-carousel]').forEach((section) => {
    const track = section.querySelector<HTMLElement>('.film-grid');
    const previous = section.querySelector<HTMLButtonElement>('[data-film-prev]');
    const next = section.querySelector<HTMLButtonElement>('[data-film-next]');
    if (!track || !previous || !next) return;

    const update = () => {
      previous.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
    };
    const move = (direction: number) => {
      const card = track.querySelector<HTMLElement>('.film-card');
      if (!card) return;
      const step = card.getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap);
      track.scrollBy({ left: direction * step, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    };
    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    track.addEventListener('scroll', update, { passive: true });
    track.addEventListener('keydown', (event) => {
      if (event.target !== track) return;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        move(event.key === 'ArrowRight' ? 1 : -1);
      }
    });
    new ResizeObserver(update).observe(track);
    update();
  });
</script>

<style>
  .film-library { padding-top: var(--s-6); scroll-margin-top: 7rem; }
  .film-intro { max-width: 40rem; margin-bottom: var(--s-5); }
  h2 { font-size: var(--t-h2); line-height: 1.15; letter-spacing: -.025em; margin-block: var(--s-3); }
  .film-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; align-items: start; }
  .film-carousel { padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem); background: var(--c-surface); border-block: 1px solid var(--c-line); }
  .film-controls { display: flex; justify-content: flex-end; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .film-buttons { display: flex; gap: .5rem; }
  .film-buttons button { display: grid; place-items: center; width: 3rem; height: 3rem; padding: 0; border: 1px solid var(--c-line); border-radius: 50%; background: var(--c-bg); color: var(--c-ink); cursor: pointer; transition: background .2s; }
  .film-buttons button:hover:not(:disabled) { background: var(--c-accent-soft); }
  .film-buttons button:disabled { opacity: .35; cursor: default; }
  .film-buttons svg { width: 1.25rem; height: 1.25rem; }
  .film-carousel .film-grid { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: calc((100% - 2rem) / 3); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 1rem; scrollbar-width: thin; scrollbar-color: var(--c-accent) var(--c-line); }
  .film-carousel .film-card { display: flex; flex-direction: column; align-self: stretch; scroll-snap-align: start; }
  .film-carousel .film-grid { overflow-y: hidden; }
  .film-carousel .film-content { display: flex; flex-direction: column; flex: 1; }
  .film-carousel .film-heading { flex: 1; }
  .film-carousel .film-strip { flex-shrink: 0; }
  .film-buttons button:focus-visible, .film-carousel .film-grid:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 4px; }
  .film-card { --film-bg: #f8f1e8; --film-ink: #635047; --strip-ink: #aa9585; min-width: 0; overflow: hidden; border: 1px solid rgb(73 55 49 / .16); border-radius: .7rem; color: var(--film-ink); background: var(--film-bg); box-shadow: 0 4px 12px -8px rgb(73 55 49 / .2); }
  .is-animation { --film-bg: #f8f1e8; }
  .is-film { --film-bg: #f1eae3; }
  .film-strip { height: .6rem; border-block: 2px solid var(--strip-ink); background: repeating-linear-gradient(90deg, var(--strip-ink) 0 8px, var(--film-bg) 8px 15px, var(--strip-ink) 15px 21px); }
  .film-content { padding: 1.1rem 1.2rem .15rem; background: linear-gradient(140deg, rgb(255 255 255 / .18), transparent); }
  .film-heading { min-height: 8rem; padding-bottom: 1rem; }
  .film-type { display: flex; align-items: center; gap: .4rem; font-size: .5625rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; margin-bottom: .65rem; }
  .film-type svg { width: 1rem; height: 1rem; flex: none; }
  h3 { font-family: var(--f-display); font-size: 1.5rem; font-weight: 500; line-height: 1.15; letter-spacing: -.025em; text-wrap: balance; }
  .film-topics { display: flex; flex-wrap: wrap; gap: .35rem; margin: .8rem 0 0; padding: 0; list-style: none; }
  .film-topics li { font-size: .6875rem; line-height: 1.4; padding: .3rem .5rem; border: 1px solid rgb(255 255 255 / .35); border-radius: .3rem; background: rgb(255 255 255 / .35); }
  .conversation { border-top: 1px solid rgb(73 55 49 / .2); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: .4rem; min-height: 44px; list-style: none; font-size: .75rem; font-weight: 500; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  summary svg { width: .875rem; height: .875rem; flex: none; transition: transform .2s; }
  details[open] summary svg { transform: rotate(45deg); }
  blockquote { margin: .2rem 0 .9rem; padding: .85rem; border-radius: .4rem; font-family: var(--f-display); font-size: 1rem; line-height: 1.45; background: rgb(255 255 255 / .35); }
  @media (min-width: 601px) and (max-width: 1000px) {
    .film-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .film-carousel .film-grid { grid-template-columns: none; grid-auto-columns: calc((100% - 1rem) / 2); }
  }
  @media (max-width: 600px) {
    .film-grid { grid-template-columns: 1fr; gap: .8rem; }
    .film-carousel .film-grid { grid-template-columns: none; grid-auto-columns: 88%; }
    h2 { font-size: 1.875rem; }
    .film-heading { min-height: 0; }
    .film-content { padding-inline: 1rem; }
    h3 { font-size: 1.375rem; }
  }
  @media (prefers-reduced-motion: reduce) { summary svg { transition: none; } }
</style>
